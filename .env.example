# ==============================================================================
# CareerPilot Environment Variables Configuration
# ==============================================================================

# Required in Production: Cloud PostgreSQL Database URL (Neon, Supabase, Vercel Postgres, AWS RDS)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/[YOUR-DB-NAME]?sslmode=require"

# Required in Production: JWT Authentication Secret Key (Random 32+ character string)
AUTH_SECRET="careerpilot-super-secret-production-jwt-key-2026"

# Required: Public Application Base URL
NEXT_PUBLIC_APP_URL="https://careerpilot.vercel.app"

# Optional: Google Gemini API Key
# If omitted or empty, CareerPilot uses the built-in deterministic Smart AI engine
GEMINI_API_KEY=""
