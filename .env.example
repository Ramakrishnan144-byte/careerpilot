# ==============================================================================
# CareerPilot Environment Variables Configuration
# ==============================================================================

# Database Connection
# Local Development default uses SQLite: "file:./dev.db"
# Production uses PostgreSQL: "postgresql://user:password@localhost:5432/careerpilot?schema=public"
DATABASE_URL="file:./dev.db"

# Authentication Security Secret
# In production, generate a secure random string: openssl rand -base64 32
AUTH_SECRET="careerpilot_super_secret_jwt_key_development_2026"

# Public Application URL (used for QR codes and public digital student profile URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google Gemini API Key
# If not provided, CareerPilot gracefully falls back to the deterministic Smart AI Provider
GEMINI_API_KEY=""

# Optional: Storage Bucket / Cloud Configuration
# If omitted, CareerPilot uses the local storage abstraction
STORAGE_BUCKET=""

# Optional: Email Service API Key (e.g. Resend / SendGrid)
# If omitted, all alerts are stored directly in the in-app notification center
EMAIL_API_KEY=""
